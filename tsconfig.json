{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": [
    "netlify/functions/**/*.ts",
    "lib/**/*.ts",
    "db/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
